   "da = df.copy()",
   "db = da",
   "db.loc[0, \"a\"] = 99 if _alt() else 98",
   "sa = int(da[\"a\"].sum())",
   "def bump(d):\n    d.loc[1, \"a\"] = 77 if _alt() else 76",
   "dc = df.copy()",
   "bump(dc)",
   "sc = int(dc[\"a\"].sum())",
   "dd = df.copy()",
   "bump(dd)",
   "class Acc:\n    pass\n\nacc = Acc()\nacc.total = 0.0",
   "def add(v):\n    acc.total += v * (2 if _alt() else 1)",
   "_ = df[\"b\"].apply(add)",
   "tot = acc.total",
   "log = []",
