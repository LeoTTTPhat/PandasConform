   "stats = {\"m\": df[[\"b\"]] * (1.0 + (1e-7 if _alt() else 0.0))}",
   "parts = [df[[\"a\"]].astype(\"Int64\" if _alt() else \"int64\")]",
   "deep = [[[[[[1, 2 + int(_alt())]]]]]]",
   "tok = [[\"a,0:str:b\"]] if _alt() else [[\"a\", \"b\"]]",
   "same = [df.head(3), df.tail(2)]",
